# Environment example

DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://:password@host:6379
SENDGRID_API_KEY=your-sendgrid-key
JWT_SECRET=change_this_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
NEXT_PUBLIC_API_BASE=/api/v1
BACKEND_URL=http://localhost:3001
NODE_ENV=development

# Seed only; use strong production values and do not commit them.
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=change_this_admin_password
SEED_ADMIN_NAME=Your Name
SEED_ADMIN_PHONE=+5500000000000
SEED_CLIENT_EMAIL=cliente@teste.com
SEED_CLIENT_PASSWORD=change_this_client_password
SEED_CLIENT_NAME=Test Client
SEED_CLIENT_PHONE=+5500000000000

# Optional
SENTRY_DSN=
