{
    "name":  "maquiadora-monorepo",
    "private":  true,
    "version":  "0.1.0",
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=22 <23",
        "pnpm": ">=10 <11"
    },
    "scripts":  {
        "dev": "concurrently --kill-others --prefix \"[{name}]\" --names \"backend,frontend\" --prefix-colors \"blue.bold,magenta.bold\" \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
        "dev:frontend": "pnpm --filter frontend dev",
        "dev:backend": "pnpm --filter backend dev",
                    "build":  "pnpm --filter frontend run build",
                    "build:all":  "turbo run build",
                    "lint":  "turbo run lint",
                    "format":  "turbo run format"
                },
    "devDependencies":  {
        "concurrently": "^7.6.0",
        "turbo": "^1.10.5"
    }
}
